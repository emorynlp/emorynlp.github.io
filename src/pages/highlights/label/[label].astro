---
import FeaturedStar from '../../../components/FeaturedStar.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatNewsDate } from '../../../lib/dates';
import { teaserFromNewsBody } from '../../../lib/newsTeaser';
import { siteHref } from '../../../lib/siteHref';

export async function getStaticPaths() {
	const all = await getCollection('highlights');
	const labels = [...new Set(all.flatMap((e) => e.data.labels ?? []))];
	return labels.map((label) => ({
		params: { label },
		props: {
			items: all
				.filter((e) => e.data.labels?.includes(label))
				.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
		},
	}));
}

const { label } = Astro.params;
const { items } = Astro.props;
---

<BaseLayout
	title={`${label} — News & Events`}
	description={`Emory NLP news and events tagged "${label}".`}
>
	<div class="news-page container-narrow">
		<p class="news-label-back">
			<a href={siteHref('/highlights/')}>← All News & Events</a>
		</p>
		<h1 class="index-page-title">
			<span class="label-heading-pill">{label}</span>
		</h1>
		{
			items.length === 0 ? (
				<div class="empty-state surface">No entries for this label.</div>
			) : (
				<ul class="news-cards" role="list">
					{items.map((n) => (
						<li class="news-cards-item">
							<div class="news-card">
								<a class="news-card-overlay" href={siteHref(`/highlights/${n.id}/`)} aria-label={n.data.title} tabindex="0" />
								{n.data.coverImage ? (
									<div class="news-card-media">
										<img
											src={siteHref(n.data.coverImage)}
											alt=""
											width={640}
											height={360}
											loading="lazy"
											decoding="async"
											style={
												n.data.coverImagePosition?.trim()
													? `object-fit: cover; object-position: ${n.data.coverImagePosition.trim()}`
													: undefined
											}
										/>
									</div>
								) : null}
								<div class="news-card-body">
									<div class="news-card-top">
										<div class="news-card-heading">
											<h2 class="news-card-title">{n.data.title}</h2>
											{n.data.featured ? <FeaturedStar /> : null}
										</div>
										<p class="news-card-date">{formatNewsDate(n.data.date)}</p>
										<p class="news-card-teaser">{teaserFromNewsBody(n.body) || 'Open for details.'}</p>
									</div>
									{n.data.labels?.length ? (
										<span class="news-label-group">
											{n.data.labels.map((l) => (
												<a
													href={siteHref(`/highlights/label/${l}/`)}
													class:list={['news-label-pill', 'news-label-pill--linked', l === label && 'news-label-pill--active']}
												>
													{l}
												</a>
											))}
										</span>
									) : null}
								</div>
							</div>
						</li>
					))}
				</ul>
			)
		}
	</div>
</BaseLayout>

<style>
	.news-label-back {
		margin: 0 0 1.5rem;
		font-size: 0.9rem;
	}

	.news-label-back a {
		color: var(--muted);
		text-decoration: none;
	}

	.news-label-back a:hover {
		color: var(--accent);
	}

	.label-heading-pill {
		display: inline-block;
		font-size: 1.75rem;
		font-weight: 800;
		text-transform: capitalize;
	}

	.news-cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1.35rem;
		align-items: stretch;
	}

	.news-cards-item {
		margin: 0;
		min-width: 0;
		display: flex;
	}

	.news-card {
		display: flex;
		flex-direction: column;
		flex: 1;
		width: 100%;
		min-height: 0;
		box-sizing: border-box;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		color: inherit;
		overflow: hidden;
		position: relative;
		transition:
			box-shadow 0.18s ease,
			border-color 0.18s ease,
			transform 0.18s ease;
	}

	.news-card-overlay {
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
	}

	.news-card-overlay:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.news-card:has(.news-card-overlay:hover) {
		border-color: rgb(148 163 184 / 0.45);
		box-shadow:
			0 1px 3px rgb(15 23 42 / 0.06),
			0 16px 40px rgb(15 23 42 / 0.08);
		transform: translateY(-2px);
	}

	.news-card:has(.news-card-overlay:hover) .news-card-title {
		color: var(--accent-hover);
	}

	.news-card-media {
		height: 11.75rem;
		flex-shrink: 0;
		background: var(--bg);
	}

	.news-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.news-card-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: 1.05rem 1.3rem 1.15rem;
		min-height: 0;
		gap: 0;
	}

	.news-card-top {
		display: flex;
		flex-direction: column;
		gap: 0.38rem;
	}

	.news-card-body > .news-label-group {
		margin-top: auto;
		padding-top: 0.5rem;
		position: relative;
		z-index: 1;
	}

	.news-card-title {
		margin: 0;
		font-size: 1.08rem;
		font-weight: 700;
		line-height: 1.38;
		color: var(--ink);
		display: -webkit-box;
		line-clamp: 3;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.news-card-date {
		margin: 0;
		font-size: 0.875rem;
		color: var(--muted);
		font-weight: 500;
	}

	.news-card-teaser {
		margin: 0;
		font-size: 0.835rem;
		line-height: 1.42;
		color: var(--muted);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		line-clamp: 3;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}
</style>
