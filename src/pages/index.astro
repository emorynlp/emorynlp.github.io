---
import FeaturedNewsSlideshow from '../components/FeaturedNewsSlideshow.astro';
import FeaturedStar from '../components/FeaturedStar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatNewsDate } from '../lib/dates';
import { teaserFromNewsBody } from '../lib/newsTeaser';
import { siteHref } from '../lib/siteHref';

const newsEntries = await getCollection('highlights');
const byDesc = (
	a: (typeof newsEntries)[number],
	b: (typeof newsEntries)[number],
) => b.data.date.valueOf() - a.data.date.valueOf();

const featured = newsEntries.filter((n) => n.data.featured).sort(byDesc);
/** Home carousel = most recent news by date (`SLIDESHOW_MAX` items). Increase if you want more slides (more dots / longer rotations). */
const SLIDESHOW_MAX = 5;
const slideshowEntries = [...newsEntries].sort(byDesc).slice(0, SLIDESHOW_MAX);
const rest = newsEntries.filter((n) => !n.data.featured).sort(byDesc);
const bannerNews = [...featured, ...rest].slice(0, 8);
---

<BaseLayout title="Home">
	<FeaturedNewsSlideshow entries={slideshowEntries} />

	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-inner">
			<h1 id="hero-title">Challenging the limit of language technology</h1>
			<p class="hero-sub">
				Research in natural language processing, dialogue, and NLP for societal impact at{' '}
				<a href="https://www.emory.edu/" style="color: inherit;">Emory University</a>.
			</p>
		</div>
	</section>

	<section class="section-block news-banner-section" aria-labelledby="news-banner-heading">
		<div class="container-narrow">
			<h2 id="news-banner-heading" class="page-title news-banner-heading">
				Latest news
			</h2>
			<p class="page-intro news-banner-intro">
				Snapshots of lab highlights. Older items live on the{' '}
				<a href={siteHref('/highlights/')}>news</a> page.
			</p>
			{
				bannerNews.length === 0 ? (
					<div class="empty-state empty-state--on-dark">No news items yet.</div>
				) : (
					<div class="banner-row">
						<div class="banner-row-inner" tabindex="0">
							{bannerNews.map((entry) => (
								<a class="banner-card"
									href={siteHref(`/highlights/${entry.id}/`)}
								>
									{
										entry.data.coverImage ? (
											<div class="banner-card-media">
												<img
													src={siteHref(entry.data.coverImage)}
													alt=""
													width="640"
													height="400"
													loading="lazy"
													decoding="async"
													style={
														entry.data.coverImagePosition?.trim()
															? `object-fit: cover; object-position: ${entry.data.coverImagePosition.trim()}`
															: undefined
													}
												/>
											</div>
										) : null
									}
									<div class="banner-card-body">
										<span class="banner-meta">{formatNewsDate(entry.data.date)}</span>
										{entry.data.labels?.length ? (
											<span class="banner-label-row">
												{entry.data.labels.map((label) => (
													<span class="banner-label-pill">{label}</span>
												))}
											</span>
										) : null}
										<div class="banner-title-row">
											<h3 class="banner-title">{entry.data.title}</h3>
											{entry.data.featured ? (
												<FeaturedStar variant="on-banner" />
											) : null}
										</div>
										<p class="banner-teaser">
											{teaserFromNewsBody(entry.body, 180) || 'Open for details.'}
										</p>
									</div>
								</a>
							))}
						</div>
					</div>
				)
			}
		</div>
	</section>

	<section class="section-block container-narrow" aria-labelledby="explore-heading">
		<h2 id="explore-heading" class="page-title">Explore</h2>
		<ul class="grid-cards" role="list" style="list-style: none; margin: 0; padding: 0;">
			<li>
				<a class="surface card-link" href={siteHref('/people/')}>People</a>
			</li>
			<li>
				<a class="surface card-link" href={siteHref('/publications/')}>Publications</a>
			</li>
			<li>
				<a class="surface card-link" href={siteHref('/projects/')}>Projects</a>
			</li>
			<li>
				<a class="surface card-link" href={siteHref('/seminars/')}>Seminars</a>
			</li>
		</ul>
	</section>
</BaseLayout>
