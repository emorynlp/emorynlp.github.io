---
import FeaturedNewsSlideshow from '../components/FeaturedNewsSlideshow.astro';
import FeaturedStar from '../components/FeaturedStar.astro';
import HomeDispatchSection from '../components/HomeDispatchSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDispatchVolumeIssue } from '../lib/dispatch/editionTicker';
import { pickCurrentDispatchIssue } from '../lib/dispatch/issueSort';
import { loadDispatchCatalog, resolveDispatchIssue } from '../lib/dispatch/resolveIssue';
import { formatNewsDate } from '../lib/dates';
import {
	DEFAULT_SEMINAR_AGENDA_PAST_COUNT,
	formatSeminarAgendaDate,
	seminarAgendaDayKind,
	seminarAgendaMeta,
	seminarsForHomeAgenda,
} from '../lib/seminarAgenda';
import { buildPublicationAuthorSlugLookup, slugForPublicationAuthor } from '../lib/publicationAuthorLinks';
import {
	resolveSeminarCoverHref,
	resolveSeminarSpeakerPhotoHrefs,
} from '../lib/seminarCoverPhotos';
import { teaserFromNewsBody } from '../lib/newsTeaser';
import { siteHref } from '../lib/siteHref';

const newsEntries = await getCollection('news');
const people = await getCollection('people');
const seminarEntries = await getCollection('seminars');
const dispatchCatalog = await loadDispatchCatalog();
const currentDispatchIssue = pickCurrentDispatchIssue(dispatchCatalog.issues);
const resolvedDispatch = currentDispatchIssue
	? resolveDispatchIssue(currentDispatchIssue, dispatchCatalog)
	: undefined;
const dispatchHighlights = resolvedDispatch?.homepageHighlights ?? [];
const authorSlugLookup = buildPublicationAuthorSlugLookup(people);
const byDesc = (
	a: { data: { date: Date } },
	b: { data: { date: Date } },
) => b.data.date.valueOf() - a.data.date.valueOf();

const featured = newsEntries.filter((n) => n.data.featured).sort(byDesc);
/** Home carousel = featured news only, most recent first (`SLIDESHOW_MAX` items). */
const SLIDESHOW_MAX = 5;
const slideshowEntries = featured.slice(0, SLIDESHOW_MAX);
/** Latest news strip = most recent items, featured and non-featured. */
const BANNER_MAX = 8;
const bannerNews = [...newsEntries].sort(byDesc).slice(0, BANNER_MAX);
const seminarAgenda = seminarsForHomeAgenda(seminarEntries, DEFAULT_SEMINAR_AGENDA_PAST_COUNT);
const agendaHasItems = seminarAgenda.upcoming !== null || seminarAgenda.past.length > 0;
const agendaRows = [
	...(seminarAgenda.upcoming ? [{ entry: seminarAgenda.upcoming, featured: true as const }] : []),
	...seminarAgenda.past.map((entry) => ({ entry, featured: false as const })),
];

function seminarAgendaCoverHref(
	entry: (typeof seminarEntries)[number],
): string | undefined {
	const speakers = entry.data.speakers ?? [];
	const primarySpeakerSlug =
		speakers.length === 1
			? slugForPublicationAuthor(speakers[0]!, authorSlugLookup)
			: undefined;
	const coverHref = resolveSeminarCoverHref(
		entry.id,
		entry.data.coverImage,
		speakers.length,
		primarySpeakerSlug,
		speakers.length === 1 ? speakers[0] : undefined,
	);
	if (coverHref) return coverHref;
	if (speakers.length >= 2) {
		return resolveSeminarSpeakerPhotoHrefs(speakers, authorSlugLookup)[0];
	}
	return undefined;
}
---

<BaseLayout title="Home">
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-inner">
			<h1 id="hero-title">Emory NLP Research Lab</h1>
			<p class="hero-sub">
				Challenging the Limit of Language Technology
			</p>
		</div>
	</section>

	<FeaturedNewsSlideshow entries={slideshowEntries} />

	{
		resolvedDispatch && dispatchHighlights.length > 0 ? (
			<section class="section-block news-banner-section" aria-labelledby="dispatch-banner-heading">
				<div class="container-narrow">
					<h2 id="dispatch-banner-heading" class="page-title news-banner-heading">
						Dispatch
					</h2>
					<p class="page-intro news-banner-intro">
						Emory NLP publishes the <a href={resolvedDispatch.issueHref}>Dispatch</a> every semester, covering our latest research, activities, and perspectives.
					</p>
					<HomeDispatchSection resolved={resolvedDispatch} />
				</div>
			</section>
		) : null
	}

	<section class="section-block news-banner-section" aria-labelledby="seminars-banner-heading">
		<div class="container-narrow">
			<h2 id="seminars-banner-heading" class="page-title news-banner-heading">
				Seminar Agenda
			</h2>
			<p class="page-intro news-banner-intro">
				Emory NLP hosts weekly <a href={siteHref('/seminars/')}>seminars</a> featuring presentations on its latest research.
			</p>
			{
				agendaHasItems ? (
					<ol class="banner-seminar-agenda" role="list">
						{agendaRows.map(({ entry, featured }) => {
							const dayKind = seminarAgendaDayKind(entry.data.date);
							const dateParts = formatSeminarAgendaDate(entry.data.date);
							const meta = seminarAgendaMeta(
								entry.data.speakers,
								entry.data.time,
								entry.data.location,
								entry.data.term,
							);
							const href = siteHref(`/seminars/${entry.id}/`);
							const coverHref = seminarAgendaCoverHref(entry);

							return (
								<li
									class:list={[
										'banner-seminar-agenda-item',
										`banner-seminar-agenda-item--${dayKind}`,
										{ 'banner-seminar-agenda-item--featured': featured },
									]}
								>
									<div class="banner-seminar-agenda-lead">
										<a class="banner-seminar-agenda-media" href={href} tabindex="-1" aria-hidden="true">
											{
												coverHref ? (
													<img
														src={siteHref(coverHref)}
														alt=""
														width="68"
														height="68"
														loading="lazy"
														decoding="async"
													/>
												) : (
													<span class="banner-seminar-agenda-media-placeholder" />
												)
											}
										</a>
										<time
											class="banner-seminar-agenda-date"
											datetime={entry.data.date.toISOString()}
										>
											<span class="banner-seminar-agenda-date-line">{dateParts.primary}</span>
											<span class="banner-seminar-agenda-date-line">{dateParts.secondary}</span>
										</time>
									</div>
									<div class="banner-seminar-agenda-body">
										<h3 class="banner-seminar-agenda-title">
											<a href={href}>{entry.data.title}</a>
										</h3>
										{meta || featured ? (
											<p class="banner-seminar-agenda-meta">
												{featured ? (
													<>
														<span class="banner-seminar-agenda-label">Upcoming</span>
														{meta ? ' · ' : null}
													</>
												) : null}
												{meta}
											</p>
										) : null}
									</div>
								</li>
							);
						})}
					</ol>
				) : (
					<div class="empty-state empty-state--on-dark">No seminar entries yet.</div>
				)
			}
		</div>
	</section>

	<section class="section-block news-banner-section" aria-labelledby="news-banner-heading">
		<div class="container-narrow">
			<h2 id="news-banner-heading" class="page-title news-banner-heading">
				Latest News
			</h2>
			<p class="page-intro news-banner-intro">
				For all  news and events from Emory NLP, please visit the {' '}
				<a href={siteHref('/news/')}>News</a> page.
			</p>
			{
				bannerNews.length === 0 ? (
					<div class="empty-state empty-state--on-dark">No news items yet.</div>
				) : (
					<div class="banner-row">
						<div class="banner-row-inner" tabindex="0">
							{bannerNews.map((entry) => (
								<a class="banner-card"
									href={siteHref(`/news/${entry.id}/`)}
								>
									{
										entry.data.coverImage ? (
											<div class="banner-card-media">
												<img
													src={siteHref(entry.data.coverImage)}
													alt=""
													width="640"
													height="400"
													loading="lazy"
													decoding="async"
													style={
														entry.data.coverImagePosition?.trim()
															? `object-fit: cover; object-position: ${entry.data.coverImagePosition.trim()}`
															: undefined
													}
												/>
											</div>
										) : null
									}
									<div class="banner-card-body">
										<span class="banner-meta">{formatNewsDate(entry.data.date)}</span>
										<div class="banner-title-row">
											<h3 class="banner-title">{entry.data.title}</h3>
											{entry.data.featured ? (
												<FeaturedStar variant="on-banner" />
											) : null}
										</div>
										<p class="banner-teaser">
											{teaserFromNewsBody(entry.body, 180) || 'Open for details.'}
										</p>
									</div>
								</a>
							))}
						</div>
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>
