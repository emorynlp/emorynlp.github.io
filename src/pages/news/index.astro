---
import FeaturedStar from '../../components/FeaturedStar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatNewsDate } from '../../lib/dates';
import { teaserFromNewsBody } from '../../lib/newsTeaser';

const items = await getCollection('news');
items.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
	title="News"
	description="Updates from Emory NLP: publications, honors, defenses, collaborations, outreach, and other lab milestones."
>
	<div class="news-page container-narrow">
		<h1 class="news-page-title">News & Events</h1>
		<p class="news-page-intro">
			Updates from Emory NLP: conference and journal papers, awards and honors, student milestones,
			collaborations, sponsored events, outreach activities, and other lab announcements.
		</p>
		{
			items.length === 0 ? (
				<div class="empty-state surface">No news entries yet.</div>
			) : (
				<ul class="news-cards" role="list">
					{items.map((n) => (
						<li class="news-cards-item">
							<a class="news-card" href={`/news/${n.id}/`}>
								{
									n.data.coverImage ? (
										<div class="news-card-media">
											<img
												src={n.data.coverImage}
												alt=""
												width={640}
												height={360}
												loading="lazy"
												decoding="async"
											/>
										</div>
									) : null
								}
								<div class="news-card-body">
									<div class="news-card-top">
										<div class="news-card-heading">
											<h2 class="news-card-title">{n.data.title}</h2>
											{n.data.featured ? <FeaturedStar /> : null}
										</div>
										<p class="news-card-date">{formatNewsDate(n.data.date)}</p>
										<p class="news-card-teaser">{teaserFromNewsBody(n.body) || 'Open for details.'}</p>
									</div>
									{n.data.labels?.length ? (
										<span class="news-label-group">
											{n.data.labels.map((label) => (
												<span class="news-label-pill">{label}</span>
											))}
										</span>
									) : null}
								</div>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</BaseLayout>

<style>
	.news-page {
		padding-block: 2rem 4rem;
	}

	.news-page-title {
		margin: 0 0 0.85rem;
		font-size: clamp(1.85rem, 4vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.news-page-intro {
		margin: 0 0 2rem;
		max-width: 62rem;
		color: var(--muted);
		line-height: 1.68;
		font-size: 1rem;
	}

	.news-page-intro a {
		color: var(--accent);
		text-decoration: none;
	}

	.news-page-intro a:hover {
		color: var(--accent-hover);
		text-decoration: none;
	}

	.news-cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1.35rem;
		align-items: stretch;
	}

	.news-cards-item {
		margin: 0;
		min-width: 0;
		display: flex;
	}

	.news-card {
		display: flex;
		flex-direction: column;
		flex: 1;
		width: 100%;
		min-height: 0;
		box-sizing: border-box;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		text-decoration: none;
		color: inherit;
		overflow: hidden;
		transition:
			box-shadow 0.18s ease,
			border-color 0.18s ease,
			transform 0.18s ease;
	}

	.news-card:hover {
		border-color: rgb(148 163 184 / 0.45);
		box-shadow:
			0 1px 3px rgb(15 23 42 / 0.06),
			0 16px 40px rgb(15 23 42 / 0.08);
		transform: translateY(-2px);
	}

	.news-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.news-card-media {
		height: 11.75rem;
		flex-shrink: 0;
		background: var(--bg);
	}

	.news-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.news-card-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: 1.05rem 1.3rem 1.15rem;
		min-height: 0;
		gap: 0;
	}

	.news-card-top {
		display: flex;
		flex-direction: column;
		gap: 0.38rem;
	}

	.news-card-body > .news-label-group {
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.news-card-title {
		margin: 0;
		font-size: 1.08rem;
		font-weight: 700;
		line-height: 1.38;
		color: var(--ink);
		display: -webkit-box;
		line-clamp: 3;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.news-card:hover .news-card-title {
		color: var(--accent-hover);
	}

	.news-card-date {
		margin: 0;
		font-size: 0.875rem;
		color: var(--muted);
		font-weight: 500;
	}

	.news-card-teaser {
		margin: 0;
		font-size: 0.835rem;
		line-height: 1.42;
		color: var(--muted);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		line-clamp: 3;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

</style>
