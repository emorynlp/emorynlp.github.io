---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';
import { siteHref } from '../../lib/siteHref';
import { resolvePeoplePhotoPublicHref } from '../../lib/peoplePhotos';
import { formatPeopleListingMeta } from '../../lib/peopleDirectory';
import {
	TIER_ORDER,
	CURRENT_TIER_HEADINGS,
	bucketByTier,
	tierSectionId,
	type PeopleTier,
} from '../../lib/peopleDirectoryPage';

const rows = await getCollection('people');
const current = rows.filter((p) => p.data.current);
const past = rows.filter((p) => !p.data.current);

const currentByTier = bucketByTier(current);

function tierUrl(tier: PeopleTier): string {
	return '#' + tierSectionId('current', tier);
}
---

<BaseLayout title="People" description="Meet the faculty, students, and collaborators at Emory NLP.">
	<div class="people-page container-narrow">
		<h1 class="index-page-title">People</h1>
		<p class="index-page-intro">
			Faculty members, postdoctoral researchers, graduate and undergraduate students, and visiting scholars who are currently active.
			{
				past.length > 0 ? (
					<>
						{' '}
						For former members and alumni, visit{' '}
						<a href={siteHref('/people/former-members/')}>Former Members</a>.
					</>
				) : null
			}
		</p>

		{
			current.length === 0 && past.length === 0 ? (
				<p class="empty-state muted">No people entries yet.</p>
			) : current.length === 0 && past.length > 0 ? (
				<p class="empty-state muted">
					There are no current members listed.{' '}
					<a href={siteHref('/people/former-members/')}>Browse the former members directory</a>.
				</p>
			) : (
				TIER_ORDER.map((tier) => {
					const list = currentByTier.get(tier) ?? [];
					if (list.length === 0) return null;

					const headingBase = CURRENT_TIER_HEADINGS[tier];
					const titleText = headingBase;
					const countSuffix = tier === 'phd' ? null : list.length > 10 ? ` (${list.length})` : null;

					return (
						<section class="people-tier-band" aria-labelledby={tierSectionId('current', tier)}>
							<h2 id={tierSectionId('current', tier)} class="people-tier-heading">
								<a class="muted people-tier-anchor" tabindex={-1} href={tierUrl(tier)} title="Link to this section">
									#
								</a>{' '}
								{titleText}
								{countSuffix}
								{tier === 'visitor' ? <span class="muted people-tier-note">Guest researchers & visiting scholars</span> : null}
							</h2>

							<div class="grid-cards people-grid">
								{list.map((person) => (
									<ContentCard
										href={siteHref(`/people/${person.id}/`)}
										title={person.data.name}
										subtitle={person.data.role}
										meta={formatPeopleListingMeta(person.data)}
										thumbnailSrc={resolvePeoplePhotoPublicHref(person.id, person.data.photo)}
										peopleDirectoryLayout
										peopleNeutralLink
									/>
								))}
							</div>
						</section>
					);
				})
			)
		}
	</div>
</BaseLayout>

<style>
	.section-divider {
		border: 0;
		border-top: 1px solid color-mix(in oklab, var(--border) 72%, transparent);
		margin-block: clamp(28px, 4vw, 40px);
	}

	.section-divider.muted {
		opacity: 0.72;
	}

	.people-openings p {
		line-height: 1.65;
	}

	.people-tier-band + .people-tier-band {
		margin-top: clamp(26px, 4vw, 48px);
	}

	.people-tier-heading {
		font-size: 1.3rem;
		font-weight: 700;
		margin: 0 0 0.85rem;
		line-height: 1.35;
	}

	.people-tier-anchor {
		text-decoration: none;
		font-weight: 600;
		opacity: 0.42;
	}

	.people-tier-anchor:hover {
		opacity: 0.85;
	}

	.people-tier-note {
		display: block;
		font-size: 0.88rem;
		font-weight: 500;
		margin-top: 0.35rem;
	}
</style>
