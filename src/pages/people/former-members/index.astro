---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import { getCollection } from 'astro:content';
import { siteHref } from '../../../lib/siteHref';
import { resolvePeoplePhotoPublicHref } from '../../../lib/peoplePhotos';
import { formatPeopleListingMeta } from '../../../lib/peopleDirectory';
import {
	TIER_ORDER,
	ALUMNI_TIER_HEADINGS,
	bucketByTier,
	tierSectionId,
	type PeopleTier,
} from '../../../lib/peopleDirectoryPage';

const formerMembers = (await getCollection('people')).filter((p) => !p.data.current);
const formerMembersByTier = bucketByTier(formerMembers);

function tierUrl(tier: PeopleTier): string {
	return '#' + tierSectionId('alumni', tier);
}
---

<BaseLayout title="Former Members" description="Former members and collaborators of Emory NLP.">
	<div class="people-page container-narrow">
		<p class="index-page-back muted">
			<a href={siteHref('/people/')}>← People</a>
		</p>
		<h1 class="index-page-title">Former Members</h1>
		<p class="index-page-intro">
			Former students, postdocs, research assistants, and visiting scholars. For current members, visit{' '}
			<a href={siteHref('/people/')}>People</a>.
		</p>

		{
			formerMembers.length === 0 ? (
				<p class="empty-state muted">No former members yet.</p>
			) : (
				TIER_ORDER.map((tier) => {
					const list = formerMembersByTier.get(tier) ?? [];
					if (list.length === 0) return null;

					const sectionId = tierSectionId('alumni', tier);
					const gridId = `alumni-grid-${tier}`;

					return (
						<section class="people-tier-band" aria-labelledby={sectionId}>
							<h2 id={sectionId} class="people-tier-heading">
								<a class="muted people-tier-anchor" tabindex={-1} href={tierUrl(tier)} title="Link to this section">
									#
								</a>{' '}
								{ALUMNI_TIER_HEADINGS[tier]}
								<span class="muted people-tier-count"> ({list.length})</span>
							</h2>

							<div class="people-tier-grid-shell" data-tier={tier} data-section-id={sectionId} data-member-count={list.length}>
								<div class="people-tier-grid-clip">
									<div id={gridId} class="grid-cards people-grid">
										{list.map((person) => (
											<ContentCard
												href={siteHref(`/people/${person.id}/`)}
												title={person.data.name}
												subtitle={person.data.role}
												meta={formatPeopleListingMeta(person.data)}
												thumbnailSrc={resolvePeoplePhotoPublicHref(person.id, person.data.photo)}
												peopleDirectoryLayout
												peopleNeutralLink
											/>
										))}
									</div>
								</div>
								<button
									type="button"
									class="people-tier-show-more muted"
									hidden
									aria-expanded="false"
									aria-controls={gridId}
								>
									Show all
								</button>
							</div>
						</section>
					);
				})
			)
		}
	</div>
</BaseLayout>

<style>
	.people-tier-band + .people-tier-band {
		margin-top: clamp(26px, 4vw, 48px);
	}

	.people-tier-heading {
		font-size: 1.3rem;
		font-weight: 700;
		margin: 0 0 0.85rem;
		line-height: 1.35;
	}

	.people-tier-count {
		font-weight: 600;
		font-size: 0.95em;
	}

	.people-tier-anchor {
		text-decoration: none;
		font-weight: 600;
		opacity: 0.42;
	}

	.people-tier-anchor:hover {
		opacity: 0.85;
	}

	.people-tier-grid-shell {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.people-tier-grid-clip {
		position: relative;
		overflow: visible;
		transition: max-height 0.35s ease;
	}

	.people-tier-grid-shell[data-collapsible='true']:not(.is-expanded) .people-tier-grid-clip {
		overflow: hidden;
	}

	.people-tier-grid-shell.is-expanded .people-tier-grid-clip {
		max-height: none;
		overflow: visible;
	}

	.people-tier-grid-shell.is-expanded .people-tier-grid-clip::after {
		opacity: 0;
		pointer-events: none;
	}

	/* Bottom fade when collapsed */
	.people-tier-grid-shell[data-collapsible='true']:not(.is-expanded) .people-tier-grid-clip::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: clamp(36px, 8vw, 56px);
		pointer-events: none;
		background: linear-gradient(to bottom, rgb(248 250 252 / 0), rgb(248 250 252 / 0.92));
		opacity: 1;
		transition: opacity 0.25s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.people-tier-grid-clip {
			transition: none;
		}

		.people-tier-grid-shell:not(.is-expanded) .people-tier-grid-clip::after {
			transition: none;
		}
	}

	.people-tier-show-more {
		align-self: flex-start;
		margin: 0;
		padding: 0.35rem 0.65rem;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		border: 1px solid rgb(203 213 225 / 0.95);
		border-radius: var(--radius);
		background: rgb(248 250 252 / 0.85);
		color: inherit;
	}

	.people-tier-show-more:hover {
		border-color: rgb(148 163 184 / 0.95);
		background: rgb(241 245 249 / 0.95);
	}

	.people-tier-show-more:focus-visible {
		outline: 2px solid var(--highlight);
		outline-offset: 2px;
	}
</style>

<script is:inline>
	(() => {
		const INITIAL_ROWS = 3;

		/**
		 * @param {HTMLElement} shell
		 */
		function measureCollapsedMaxPx(shell) {
			const clip = shell.querySelector('.people-tier-grid-clip');
			const grid = shell.querySelector('.people-grid');
			if (!clip || !grid || grid.children.length === 0) return null;

			const items = [...grid.children];
			const rowTops = items.map((el) => Math.round(el.getBoundingClientRect().top));
			const uniqueTops = [...new Set(rowTops)].sort((a, b) => a - b);
			if (uniqueTops.length <= INITIAL_ROWS) return null;

			const cutTop = uniqueTops[INITIAL_ROWS - 1];
			let rowBottom = 0;
			for (const el of items) {
				if (Math.round(el.getBoundingClientRect().top) === cutTop) {
					rowBottom = Math.max(rowBottom, el.getBoundingClientRect().bottom);
				}
			}
			const gridTop = grid.getBoundingClientRect().top;
			const raw = rowBottom - gridTop;
			return Math.ceil(raw + 0.5);
		}

		/**
		 * @param {HTMLElement} shell
		 */
		function applyCollapse(shell) {
			const btn = shell.querySelector('.people-tier-show-more');
			const clip = shell.querySelector('.people-tier-grid-clip');
			const grid = shell.querySelector('.people-grid');
			if (!btn || !clip || !grid) return;

			if (shell.classList.contains('is-expanded')) {
				btn.hidden = true;
				return;
			}

			const maxPx = measureCollapsedMaxPx(shell);
			if (maxPx == null) {
				shell.removeAttribute('data-collapsible');
				clip.style.maxHeight = '';
				clip.style.overflow = '';
				btn.hidden = true;
				btn.setAttribute('aria-expanded', 'false');
				return;
			}

			shell.dataset.collapsible = 'true';
			clip.style.maxHeight = `${maxPx}px`;
			clip.style.overflow = 'hidden';
			btn.hidden = false;
			btn.setAttribute('aria-expanded', 'false');
			const count = shell.getAttribute('data-member-count') || '';
			btn.textContent = count ? `Show all (${count})` : 'Show all';
		}

		function initShell(shell) {
			const btn = shell.querySelector('.people-tier-show-more');
			const sectionId = shell.getAttribute('data-section-id') || '';

			if (sectionId && window.location.hash === `#${sectionId}`) {
				const clip = shell.querySelector('.people-tier-grid-clip');
				shell.classList.add('is-expanded');
				if (clip) {
					clip.style.maxHeight = '';
					clip.style.overflow = '';
				}
				if (btn) {
					btn.hidden = true;
					btn.setAttribute('aria-expanded', 'true');
				}
				return;
			}

			applyCollapse(shell);

			btn?.addEventListener('click', () => {
				const clip = shell.querySelector('.people-tier-grid-clip');
				shell.classList.add('is-expanded');
				if (clip) {
					clip.style.maxHeight = '';
					clip.style.overflow = '';
				}
				btn.hidden = true;
				btn.setAttribute('aria-expanded', 'true');
			});
		}

		const shells = [...document.querySelectorAll('.people-tier-grid-shell')];
		for (const shell of shells) {
			initShell(shell);
			const ro = new ResizeObserver(() => {
				if (!shell.classList.contains('is-expanded')) applyCollapse(shell);
			});
			const grid = shell.querySelector('.people-grid');
			if (grid) ro.observe(grid);
		}

		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				for (const shell of shells) {
					if (!shell.classList.contains('is-expanded')) applyCollapse(shell);
				}
			});
		});

		window.addEventListener('hashchange', () => {
			for (const shell of shells) {
				const sectionId = shell.getAttribute('data-section-id') || '';
				if (sectionId && window.location.hash === `#${sectionId}`) {
					const clip = shell.querySelector('.people-tier-grid-clip');
					shell.classList.add('is-expanded');
					if (clip) {
						clip.style.maxHeight = '';
						clip.style.overflow = '';
					}
					const btn = shell.querySelector('.people-tier-show-more');
					if (btn) {
						btn.hidden = true;
						btn.setAttribute('aria-expanded', 'true');
					}
				}
			}
		});
	})();
</script>
