---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteHref } from '../../lib/siteHref';
import { publicationAbstractParagraphs } from '../../lib/publicationAbstract';
import { buildPublicationAuthorSlugLookup, slugForPublicationAuthor } from '../../lib/publicationAuthorLinks';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
	const entries = await getCollection('seminars');
	return entries.map((entry) => ({
		params: { slug: entry.id },
	}));
}

const { slug } = Astro.params;
const entry =
	slug !== undefined
		? ((await getEntry('seminars', slug)) as CollectionEntry<'seminars'> | undefined)
		: undefined;

if (entry === undefined) {
	return Astro.redirect(siteHref('/seminars/'));
}

const people = await getCollection('people');
const authorSlugLookup = buildPublicationAuthorSlugLookup(people);

const { Content } = await render(entry);
const d = entry.data;

const speakers = d.speakers ?? [];
const abstractBlocks = publicationAbstractParagraphs(d.abstract);
const bioBlocks = publicationAbstractParagraphs(d.bio);
const slidesHref = d.slidesUrl?.trim();
const videoHref = d.videoUrl?.trim();
const speakerHref = d.speakerUrl?.trim();
const timeLabel = d.time?.trim() || '';
const locationLabel = d.location?.trim() || '';

const resourceLinks = [
	slidesHref && { href: slidesHref, label: 'Slides' },
	videoHref && { href: videoHref, label: 'Recording' },
].filter(Boolean) as {
	href: string;
	label: string;
}[];

const descriptionParts = [
	...(speakers.length > 0 ? [speakers.slice(0, 3).join(', ') + (speakers.length > 3 ? ', …' : '')] : []),
	d.term,
].filter(Boolean);
---

<BaseLayout title={d.title} description={descriptionParts.join(' · ')}>
	<div class="publications-page container-narrow">
		<p class="publications-detail-back muted">
			<a href={siteHref('/seminars/')}>← Seminars</a>
		</p>

		<article class="publications-detail-article">
			<header class="publications-detail-header">
				<h1 class="publications-detail-title">{d.title}</h1>

				{
					speakers.length > 0 ? (
						<p class="publications-detail-authors">
							{speakers.map((speaker, i) => {
								const peopleSlug = slugForPublicationAuthor(speaker, authorSlugLookup);
								const peopleHref = peopleSlug ? siteHref(`/people/${peopleSlug}/`) : undefined;
								const seminarSpeakerHref =
									speakers.length === 1 && speakerHref ? speakerHref : undefined;
								const linkHref = seminarSpeakerHref ?? peopleHref;
								return (
									<>
										{i > 0 ? ', ' : ''}
										{linkHref ? (
											<a
												class="publication-card-author-link"
												href={linkHref}
												{...(seminarSpeakerHref
													? { target: '_blank', rel: 'noopener noreferrer' }
													: {})}
											>
												{speaker}
											</a>
										) : (
											<span>{speaker}</span>
										)}
									</>
								);
							})}
						</p>
					) : null
				}
			</header>

			{
				abstractBlocks.length > 0 ? (
					<section class="publications-detail-abstract-wrap" aria-labelledby="seminar-abs-h">
						<h2 id="seminar-abs-h" class="publications-detail-field-label">
							Abstract
						</h2>
						<div class="publications-detail-abstract">
							{abstractBlocks.map((block) => (
								<p class="publications-detail-abstract-p">{block}</p>
							))}
						</div>
					</section>
				) : null
			}

			<div class="publications-detail-paper-meta" role="region" aria-label="Seminar details">
				<span class="publications-detail-field-label publications-detail-meta-row-label" id="seminar-term-label">
					Term
				</span>
				<div
					class="publications-detail-meta-value publications-detail-meta-value-cell"
					aria-labelledby="seminar-term-label"
				>
					{d.term}
				</div>
				<span class="publications-detail-field-label publications-detail-meta-row-label" id="seminar-date-label">
					Date
				</span>
				<div
					class="publications-detail-meta-value publications-detail-meta-value--tabular publications-detail-meta-value-cell"
					aria-labelledby="seminar-date-label"
				>
					{d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
				</div>
				{
					timeLabel ? (
						<>
							<span
								class="publications-detail-field-label publications-detail-meta-row-label"
								id="seminar-time-label"
							>
								Time
							</span>
							<div
								class="publications-detail-meta-value publications-detail-meta-value-cell"
								aria-labelledby="seminar-time-label"
							>
								{timeLabel}
							</div>
						</>
					) : null
				}
				{
					locationLabel ? (
						<>
							<span
								class="publications-detail-field-label publications-detail-meta-row-label"
								id="seminar-location-label"
							>
								Location
							</span>
							<div
								class="publications-detail-meta-value publications-detail-meta-value-cell"
								aria-labelledby="seminar-location-label"
							>
								{
									/^https?:\/\//.test(locationLabel) ? (
										<a
											class="publications-detail-venue-link"
											href={locationLabel}
											target="_blank"
											rel="noopener noreferrer"
										>
											{locationLabel}
										</a>
									) : (
										locationLabel
									)
								}
							</div>
						</>
					) : null
				}
				{
					bioBlocks.length > 0 ? (
						<section
							class="publications-detail-bio-wrap publications-detail-paper-meta-bio"
							aria-label="Speaker biography"
						>
							<div class="publications-detail-bio">
								{bioBlocks.map((block) => (
									<p class="publications-detail-bio-p">{block}</p>
								))}
							</div>
						</section>
					) : null
				}
				{
					resourceLinks.length > 0 ? (
						<>
							<h2
								id="seminar-links-h"
								class="publications-detail-field-label publications-detail-meta-row-label publications-detail-links-heading"
							>
								Links
							</h2>
							<nav
								class="publications-detail-linkbar publications-detail-meta-value-cell"
								aria-label="Seminar links"
								aria-labelledby="seminar-links-h"
							>
								{resourceLinks.map((lnk, i) => (
									<>
										{i > 0 ? (
											<span class="publications-detail-linkbar-sep" aria-hidden="true">·</span>
										) : null}
										<a
											class="publications-detail-linkbar-a"
											href={lnk.href}
											target="_blank"
											rel="noopener noreferrer"
										>
											{lnk.label}
										</a>
									</>
								))}
							</nav>
						</>
					) : null
				}
			</div>

			<div class="publications-detail-body prose-slot">
				<Content />
			</div>
		</article>
	</div>
</BaseLayout>
