---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildPublicationAuthorSlugLookup, slugForPublicationAuthor } from '../../../lib/publicationAuthorLinks';
import { thesisAwardingSubtitle } from '../../../lib/thesisAffiliation';
import { compareThesesListingOrder, thesisSortYear, thesisTermNoteLabel } from '../../../lib/thesisYear';
import { siteHref } from '../../../lib/siteHref';
import { thesisDegreeKind } from '../../../lib/degreeListKind';
import { resolvePeoplePhotoPublicHref } from '../../../lib/peoplePhotos';

const people = await getCollection('people');
const authorSlugLookup = buildPublicationAuthorSlugLookup(people);
const peopleById = new Map(people.map((p) => [p.id, p]));

const items = await getCollection('theses');
items.sort(compareThesesListingOrder);

const yearRangeMax =
	items.length > 0 ? Math.max(...items.map((t) => thesisSortYear(t.data.term, t.id))) : new Date().getFullYear();
const pickerYearMin = 2015;
const pickerYearMax = new Date().getFullYear();
const startYearOptions: number[] = [];
for (let y = pickerYearMin; y <= pickerYearMax; y++) startYearOptions.push(y);
const defaultStartYear = Math.min(pickerYearMax, Math.max(pickerYearMin, pickerYearMax - 3));
const defaultEndYear = Math.min(pickerYearMax, Math.max(defaultStartYear, yearRangeMax));
const endYearOptions: number[] = [];
for (let y = defaultStartYear; y <= pickerYearMax; y++) endYearOptions.push(y);

const degreeOrder = [
	'PhD',
	'MS',
	'Undergrad',
	'Undergraduate Honors',
	'Undergraduate Thesis',
	'Masters Thesis',
	'Dissertation',
	'Other',
];
const degreeSet = new Set(items.map((t) => t.data.degree));
const degreeOptions = degreeOrder.filter((d) => {
	if (d === 'Undergrad') {
		return degreeSet.has('BS') || degreeSet.has('BA');
	}
	return degreeSet.has(d);
});
const degreeCatalogForClient = degreeOptions.map((degree) => ({ value: degree, label: degree }));

---

<BaseLayout title="Theses & Dissertations" description="Student theses defended with Emory NLP.">
	<div class="publications-page container-narrow">
		<p class="index-page-back muted">
			<a href={siteHref('/papers/')}>← Publications</a>
		</p>
		<h1 class="index-page-title">Theses &amp; Dissertations</h1>
		<p class="index-page-intro">
			PhD dissertations, MS theses, and undergraduate honors theses.
			Use the year range, degree, and search box to narrow results.
			For conference and journal papers, visit{' '}
			<a href={siteHref('/papers/')}>Publications</a>.
		</p>
		{
			items.length === 0 ? (
				<div class="empty-state surface">No thesis entries yet.</div>
			) : (
				<div
					class="theses-list-wrap"
					data-picker-min={String(pickerYearMin)}
					data-picker-max={String(pickerYearMax)}
					data-default-start={String(defaultStartYear)}
					data-default-end={String(defaultEndYear)}
					data-selected-degree=""
				>
					<div class="publications-filters-pane">
						<div class="publications-year-filter" role="group" aria-label="Filter by year">
							<div class="publications-year-filter-field">
								<label class="publications-year-filter-label" for="thesis-year-start">Start</label>
								<select class="publications-year-filter-select" id="thesis-year-start" name="yearStart">
									{startYearOptions.map((y) => (
										<option value={String(y)} selected={y === defaultStartYear}>
											{y}
										</option>
									))}
								</select>
							</div>
							<div class="publications-year-filter-field">
								<label class="publications-year-filter-label" for="thesis-year-end">End</label>
								<select class="publications-year-filter-select" id="thesis-year-end" name="yearEnd">
									{endYearOptions.map((y) => (
										<option value={String(y)} selected={y === defaultEndYear}>
											{y}
										</option>
									))}
								</select>
							</div>
						</div>
						<div class="publications-author-filter-block">
							<span class="publications-year-filter-label" id="thesis-degree-filter-heading">
								Degree
							</span>
							<div class="publications-author-filter" id="thesis-degree-filter-root">
								<button
									type="button"
									class="publications-author-filter-trigger publications-author-filter-trigger--text-only"
									id="thesis-degree-trigger"
									aria-expanded="false"
									aria-haspopup="listbox"
									aria-controls="thesis-degree-menu"
									aria-labelledby="thesis-degree-filter-heading thesis-degree-trigger-label"
								>
									<span class="publications-author-filter-trigger-text" id="thesis-degree-trigger-label">
										All degrees
									</span>
								</button>
								<div
									class="publications-author-filter-menu"
									id="thesis-degree-menu"
									role="listbox"
									aria-labelledby="thesis-degree-filter-heading"
									hidden
								/>
							</div>
						</div>
						<div class="publications-title-search-field">
							<label class="publications-year-filter-label" for="thesis-search">Search</label>
							<input
								type="search"
								class="publications-title-search-input"
								id="thesis-search"
								name="search"
								placeholder="Search title or author…"
								spellcheck="false"
								autocomplete="off"
								enterkeyhint="search"
							/>
						</div>
					</div>
					<script type="application/json" id="thesis-degree-catalog" set:html={JSON.stringify(degreeCatalogForClient)} />
					<p class="publications-filter-stats" id="thesis-filter-stats" role="status" aria-live="polite">
						<span class="publications-filter-stats-summary">
							Total <strong id="thesis-stat-total" class="publications-filter-stats-num">0</strong>
						</span>
						<span class="publications-filter-stats-sep publications-filter-stats-sep--em" aria-hidden="true">—</span>
						<span class="publications-filter-stats-kind thesis-filter-stats-kind--phd">
							PhD <strong id="thesis-stat-phd" class="publications-filter-stats-num">0</strong>
						</span>
						<span class="publications-filter-stats-sep publications-filter-stats-sep--dot" aria-hidden="true">·</span>
						<span class="publications-filter-stats-kind thesis-filter-stats-kind--ms">
							MS <strong id="thesis-stat-ms" class="publications-filter-stats-num">0</strong>
						</span>
						<span class="publications-filter-stats-sep publications-filter-stats-sep--dot" aria-hidden="true">·</span>
						<span class="publications-filter-stats-kind thesis-filter-stats-kind--undergrad">
							Undergrad <strong id="thesis-stat-undergrad" class="publications-filter-stats-num">0</strong>
						</span>
					</p>
					<p id="thesis-filter-empty" class="publications-year-filter-empty muted" hidden>
						No theses/dissertations match these filters.
					</p>
					<ul class="theses-list" role="list" id="theses-list">
						{items.map((t) => {
							const authorSlug = slugForPublicationAuthor(t.data.author, authorSlugLookup);
							const rawPeoplePhoto =
								authorSlug !== undefined
									? resolvePeoplePhotoPublicHref(authorSlug, peopleById.get(authorSlug)?.data.photo)
									: undefined;
							const listThumbHref = rawPeoplePhoto ? siteHref(rawPeoplePhoto) : undefined;
							const authorNode =
								authorSlug !== undefined ? (
									<a class="theses-list-author-link" href={siteHref(`/people/${authorSlug}/`)}>
										{t.data.author}
									</a>
								) : (
									<span>{t.data.author}</span>
								);
							const affiliation = thesisAwardingSubtitle(t.data.degree, t.data.department);
							return (
								<li
									class:list={[
										'theses-list-item',
										'surface',
										`theses-list-item--kind-${thesisDegreeKind(t.data.degree)}`,
									]}
									data-year={String(thesisSortYear(t.data.term, t.id))}
									data-degree={t.data.degree}
									data-degree-kind={thesisDegreeKind(t.data.degree)}
									data-search={`${t.data.title} ${t.data.author}`.toLowerCase()}
								>
									<div class="theses-list-item-inner">
										<a
											class="theses-list-thumb-link"
											href={siteHref(`/papers/theses/${t.id}/`)}
											aria-hidden="true"
											tabindex="-1"
										>
											{listThumbHref ? (
												<img
													class="theses-list-thumb"
													src={listThumbHref}
													alt=""
													width="144"
													height="144"
													loading="lazy"
													decoding="async"
												/>
											) : (
												<span class="theses-list-thumb-placeholder" />
											)}
										</a>
										<div class="theses-list-main">
											<h2 class="theses-list-title">
												<a href={siteHref(`/papers/theses/${t.id}/`)}>{t.data.title}</a>
											</h2>
											<p class="theses-list-meta">
												{authorNode} · {t.data.degree} · {thesisTermNoteLabel(t.data.term, t.id)}
											</p>
											{affiliation ? <p class="theses-list-sub muted">{affiliation}</p> : null}
										</div>
									</div>
								</li>
							);
						})}
					</ul>
				</div>
			)
		}
	</div>
	<script is:inline>
		(function () {
			const wrap = document.querySelector('.theses-list-wrap');
			if (!wrap) return;
			const pickerMin = Number(wrap.dataset.pickerMin);
			const pickerMax = Number(wrap.dataset.pickerMax);
			const defaultStart = Number(wrap.dataset.defaultStart);
			const defaultEnd = Number(wrap.dataset.defaultEnd);
			const startSelect = document.getElementById('thesis-year-start');
			const endSelect = document.getElementById('thesis-year-end');
			const degreeRoot = document.getElementById('thesis-degree-filter-root');
			const degreeTrigger = document.getElementById('thesis-degree-trigger');
			const degreeMenu = document.getElementById('thesis-degree-menu');
			const degreeTriggerLabel = document.getElementById('thesis-degree-trigger-label');
			const searchInput = document.getElementById('thesis-search');
			const items = wrap.querySelectorAll('.theses-list-item[data-year]');
			const emptyEl = document.getElementById('thesis-filter-empty');
			const statTotal = document.getElementById('thesis-stat-total');
			const statPhd = document.getElementById('thesis-stat-phd');
			const statMs = document.getElementById('thesis-stat-ms');
			const statUndergrad = document.getElementById('thesis-stat-undergrad');
			if (!startSelect || !endSelect || !degreeMenu) return;

			function clamp(n, a, b) {
				if (Number.isNaN(n)) return a;
				return Math.min(b, Math.max(a, n));
			}

			function readFiltersFromLocation() {
				const params = new URLSearchParams(window.location.search);
				let lo = parseInt(params.get('yearStart') ?? '', 10);
				let hi = parseInt(params.get('yearEnd') ?? '', 10);
				if (Number.isNaN(lo)) lo = defaultStart;
				if (Number.isNaN(hi)) hi = defaultEnd;
				lo = clamp(lo, pickerMin, pickerMax);
				hi = clamp(hi, pickerMin, pickerMax);
				return {
					lo,
					hi: Math.max(lo, hi),
					degree: String(params.get('degree') ?? '').trim(),
					query: String(params.get('q') ?? '').trim().toLowerCase(),
				};
			}

			function syncFiltersToLocation(lo, hi, degree, query) {
				const params = new URLSearchParams(window.location.search);
				if (lo === defaultStart) params.delete('yearStart');
				else params.set('yearStart', String(lo));
				if (hi === defaultEnd) params.delete('yearEnd');
				else params.set('yearEnd', String(hi));
				const degreeValue = String(degree || '').trim();
				if (!degreeValue) params.delete('degree');
				else params.set('degree', degreeValue);
				const queryValue = String(query || '').trim();
				if (!queryValue) params.delete('q');
				else params.set('q', queryValue);
				const qs = params.toString();
				const next = qs ? window.location.pathname + '?' + qs : window.location.pathname;
				const current = window.location.pathname + window.location.search;
				if (next !== current) {
					history.replaceState(null, '', next);
				}
			}

			function rebuildEndOptions(startVal, preferredEnd) {
				const lo = clamp(startVal, pickerMin, pickerMax);
				let endVal = preferredEnd;
				if (endVal == null || Number.isNaN(endVal)) {
					endVal = parseInt(endSelect.value, 10);
				}
				endVal = clamp(Number.isNaN(endVal) ? lo : endVal, lo, pickerMax);
				endSelect.innerHTML = '';
				for (let y = lo; y <= pickerMax; y++) {
					const opt = document.createElement('option');
					opt.value = String(y);
					opt.textContent = String(y);
					endSelect.appendChild(opt);
				}
				endSelect.value = String(endVal);
			}

			let degreeCatalogCache = null;
			function getDegreeCatalog() {
				if (degreeCatalogCache !== null) return degreeCatalogCache;
				const el = document.getElementById('thesis-degree-catalog');
				if (!el || !el.textContent) {
					degreeCatalogCache = [];
					return degreeCatalogCache;
				}
				try {
					degreeCatalogCache = JSON.parse(el.textContent.trim());
				} catch (_) {
					degreeCatalogCache = [];
				}
				return degreeCatalogCache;
			}

			function getSelectedDegree() {
				return wrap.getAttribute('data-selected-degree') || '';
			}

			function setSelectedDegree(value) {
				wrap.setAttribute('data-selected-degree', value || '');
				apply();
			}

			function setDegreeMenuOpen(open) {
				if (!degreeMenu || !degreeTrigger) return;
				degreeMenu.hidden = !open;
				degreeTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
			}

			function syncDegreeTrigger() {
				if (!degreeTrigger || !degreeTriggerLabel || !degreeMenu) return;
				const cur = getSelectedDegree();
				let selectedBtn = null;
				for (const btn of degreeMenu.querySelectorAll('.publications-author-filter-option')) {
					if ((btn.getAttribute('data-value') ?? '') === cur) {
						selectedBtn = btn;
						break;
					}
				}
				if (!selectedBtn) {
					selectedBtn = degreeMenu.querySelector('.publications-author-filter-option[data-value=""]');
				}
				for (const btn of degreeMenu.querySelectorAll('.publications-author-filter-option')) {
					btn.setAttribute('aria-selected', btn === selectedBtn ? 'true' : 'false');
				}
				const label = selectedBtn ? selectedBtn.getAttribute('data-label') || 'All degrees' : 'All degrees';
				const count = selectedBtn ? selectedBtn.getAttribute('data-count') : null;
				degreeTriggerLabel.textContent =
					count && count !== '' ? label + ' (' + count + ')' : label;
			}

			function appendDegreeMenuOption(menu, value, label, count) {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className =
					'publications-author-filter-option publications-filter-menu-option--text-only';
				btn.setAttribute('role', 'option');
				btn.setAttribute('data-value', value);
				btn.setAttribute('data-label', label);
				if (count > 0) btn.setAttribute('data-count', String(count));
				btn.setAttribute('aria-selected', 'false');
				const main = document.createElement('span');
				main.className = 'publications-author-filter-option-main';
				main.appendChild(document.createTextNode(label + (count > 0 ? ' ' : '')));
				if (count > 0) {
					const cspan = document.createElement('span');
					cspan.className = 'publications-author-filter-option-count muted';
					cspan.textContent = '(' + count + ')';
					main.appendChild(cspan);
				}
				btn.appendChild(main);
				menu.appendChild(btn);
				return btn;
			}

			function itemMatchesDegreeFilter(degree, filterValue) {
				if (!filterValue) return true;
				if (filterValue === 'Undergrad') return degree === 'BS' || degree === 'BA';
				return degree === filterValue;
			}

			function rebuildDegreeOptions(lo, hi, query) {
				const catalog = getDegreeCatalog();
				if (!catalog.length) return;
				const cur = getSelectedDegree();
				const countByDegree = {};
				catalog.forEach(function (entry) {
					countByDegree[entry.value] = 0;
				});
				items.forEach((li) => {
					const y = parseInt(li.getAttribute('data-year'), 10);
					if (Number.isNaN(y) || y < lo || y > hi) return;
					const hay = li.getAttribute('data-search') || '';
					if (query && hay.indexOf(query) === -1) return;
					const degree = li.getAttribute('data-degree') || '';
					catalog.forEach(function (entry) {
						if (itemMatchesDegreeFilter(degree, entry.value)) {
							countByDegree[entry.value] += 1;
						}
					});
				});
				if (cur && !countByDegree[cur]) {
					wrap.setAttribute('data-selected-degree', '');
				}
				while (degreeMenu.firstChild) {
					degreeMenu.removeChild(degreeMenu.firstChild);
				}
				appendDegreeMenuOption(degreeMenu, '', 'All degrees', 0);
				catalog.forEach(function (entry) {
					const count = countByDegree[entry.value] || 0;
					if (count <= 0) return;
					appendDegreeMenuOption(degreeMenu, entry.value, entry.label, count);
				});
			}

			function apply() {
				const lo = clamp(parseInt(startSelect.value, 10), pickerMin, pickerMax);
				const hi = clamp(parseInt(endSelect.value, 10), pickerMin, pickerMax);
				const endYear = Math.max(lo, hi);
				const query = String((searchInput && searchInput.value) || '').trim().toLowerCase();
				rebuildDegreeOptions(lo, endYear, query);
				const selectedDegree = getSelectedDegree();
				startSelect.value = String(lo);
				endSelect.value = String(endYear);
				let visible = 0;
				let nPhd = 0;
				let nMs = 0;
				let nUndergrad = 0;
				items.forEach((li) => {
					const y = parseInt(li.getAttribute('data-year'), 10);
					const degree = li.getAttribute('data-degree') || '';
					const degreeKind = li.getAttribute('data-degree-kind') || 'other';
					const hay = li.getAttribute('data-search') || '';
					const yearOk = !Number.isNaN(y) && y >= lo && y <= endYear;
					const degreeOk =
						!selectedDegree ||
						(selectedDegree === 'Undergrad'
							? degree === 'BS' || degree === 'BA'
							: degree === selectedDegree);
					const queryOk = !query || hay.indexOf(query) !== -1;
					const show = yearOk && degreeOk && queryOk;
					li.toggleAttribute('hidden', !show);
					if (!show) return;
					visible += 1;
					if (degreeKind === 'phd') nPhd += 1;
					else if (degreeKind === 'ms') nMs += 1;
					else if (degreeKind === 'undergrad') nUndergrad += 1;
				});
				if (emptyEl) emptyEl.hidden = visible > 0;
				if (statTotal) statTotal.textContent = String(visible);
				if (statPhd) statPhd.textContent = String(nPhd);
				if (statMs) statMs.textContent = String(nMs);
				if (statUndergrad) statUndergrad.textContent = String(nUndergrad);
				syncDegreeTrigger();
				syncFiltersToLocation(lo, endYear, selectedDegree, query);
			}

			function onStartChange() {
				const lo = clamp(parseInt(startSelect.value, 10), pickerMin, pickerMax);
				const hi = clamp(parseInt(endSelect.value, 10), pickerMin, pickerMax);
				rebuildEndOptions(lo, hi);
				apply();
			}

			function syncFiltersFromLocation() {
				const filters = readFiltersFromLocation();
				startSelect.value = String(filters.lo);
				rebuildEndOptions(filters.lo, filters.hi);
				if (searchInput) searchInput.value = filters.query;
				wrap.setAttribute('data-selected-degree', filters.degree);
				apply();
			}

			startSelect.addEventListener('change', onStartChange);
			endSelect.addEventListener('change', apply);
			startSelect.addEventListener('input', onStartChange);
			endSelect.addEventListener('input', apply);
			if (degreeRoot && degreeTrigger && degreeMenu) {
				degreeTrigger.addEventListener('click', function (e) {
					e.stopPropagation();
					const open = degreeMenu.hidden;
					setDegreeMenuOpen(open);
				});
				degreeMenu.addEventListener('click', function (e) {
					const btn = e.target.closest('.publications-author-filter-option');
					if (!btn || !degreeMenu.contains(btn)) return;
					const value = btn.getAttribute('data-value') ?? '';
					setSelectedDegree(value);
					setDegreeMenuOpen(false);
				});
				document.addEventListener('click', function () {
					setDegreeMenuOpen(false);
				});
				degreeRoot.addEventListener('click', function (e) {
					e.stopPropagation();
				});
				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape' && degreeMenu && !degreeMenu.hidden) {
						setDegreeMenuOpen(false);
					}
				});
			}

			if (searchInput) {
				searchInput.addEventListener('input', apply);
				searchInput.addEventListener('search', apply);
			}
			syncFiltersFromLocation();
			window.addEventListener('pageshow', syncFiltersFromLocation);
		})();
	</script>
</BaseLayout>
