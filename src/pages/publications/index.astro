---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationListItem from '../../components/PublicationListItem.astro';
import { getCollection } from 'astro:content';
import { buildPublicationAuthorSlugLookup } from '../../lib/publicationAuthorLinks';
import {
	buildMemberAuthorFilterOptions,
	memberSlugsOnPublicationPaper,
} from '../../lib/publicationsAuthorFilter';
import { buildPublicationsSidebarModel } from '../../lib/publicationsPageSidebar';
import {
	publicationListingKind,
	publicationSearchHaystack,
	publicationSortInstant,
} from '../../lib/publicationListing';
import { siteHref } from '../../lib/siteHref';

const people = await getCollection('people');
const authorSlugLookup = buildPublicationAuthorSlugLookup(people);

const papers = await getCollection('publications');
papers.sort((a, b) => {
	const ta = publicationSortInstant(a.data);
	const tb = publicationSortInstant(b.data);
	const cmp = tb - ta;
	return cmp !== 0 ? cmp : a.data.title.localeCompare(b.data.title);
});

const sidebar = buildPublicationsSidebarModel(papers, authorSlugLookup, people);

const yearRangeMax =
	papers.length > 0 ? Math.max(...papers.map((p) => p.data.year)) : new Date().getFullYear();

const pickerYearMin = 2015;
const pickerYearMax = new Date().getFullYear();
const startYearOptions: number[] = [];
for (let y = pickerYearMin; y <= pickerYearMax; y++) startYearOptions.push(y);
const defaultStartYear = Math.min(pickerYearMax, Math.max(pickerYearMin, pickerYearMax - 3));
const defaultEndYear = Math.min(pickerYearMax, Math.max(defaultStartYear, yearRangeMax));
const endYearOptions: number[] = [];
for (let y = defaultStartYear; y <= pickerYearMax; y++) endYearOptions.push(y);

const memberAuthorFilterOptions = buildMemberAuthorFilterOptions(sidebar.authors, people);
const authorCatalogForClient = memberAuthorFilterOptions.map(({ slug, name, photoHref }) => ({
	slug,
	name,
	photoHref: photoHref ?? null,
}));
---

<BaseLayout
	title="Publications"
	description="Conference and journal papers, workshop articles, and preprints from Emory NLP."
>
	<div class="publications-page container-narrow">
		<h1 class="index-page-title">Publications</h1>
		<p class="index-page-intro">
			Peer-reviewed papers from journals, conferences, and workshops (including shared tasks and system demonstrations), plus preprints.
			Use the year range, author, and search box to narrow results.
			{' '}
			For theses and dissertations, visit{' '}
			<a href={siteHref('/publications/theses/')}>Theses &amp; Dissertations</a>.
		</p>
		{
			papers.length === 0 ? (
				<div class="empty-state surface">No publication entries yet.</div>
			) : (
				<div
					class="publications-list-wrap"
					data-picker-min={String(pickerYearMin)}
					data-picker-max={String(pickerYearMax)}
					data-default-start={String(defaultStartYear)}
					data-default-end={String(defaultEndYear)}
					data-selected-author=""
				>
					<div class="publications-filters-pane">
						<div class="publications-year-filter" role="group" aria-label="Filter by year">
							<div class="publications-year-filter-field">
								<label class="publications-year-filter-label" for="pub-year-start">Start</label>
								<select class="publications-year-filter-select" id="pub-year-start" name="yearStart">
									{startYearOptions.map((y) => (
										<option value={String(y)} selected={y === defaultStartYear}>
											{y}
										</option>
									))}
								</select>
							</div>
							<div class="publications-year-filter-field">
								<label class="publications-year-filter-label" for="pub-year-end">End</label>
								<select class="publications-year-filter-select" id="pub-year-end" name="yearEnd">
									{endYearOptions.map((y) => (
										<option value={String(y)} selected={y === defaultEndYear}>
											{y}
										</option>
									))}
								</select>
							</div>
						</div>
						{
							memberAuthorFilterOptions.length > 0 ? (
								<div class="publications-author-filter-block">
									<span class="publications-year-filter-label" id="pub-author-filter-heading">
										Author
									</span>
									<div class="publications-author-filter" id="pub-author-filter-root">
										<button
											type="button"
											class="publications-author-filter-trigger"
											id="pub-author-trigger"
											aria-expanded="false"
											aria-haspopup="listbox"
											aria-controls="pub-author-menu"
											aria-labelledby="pub-author-filter-heading pub-author-trigger-label"
										>
											<span class="publications-author-filter-trigger-thumb" aria-hidden="true">
												<span class="publications-author-filter-thumb-placeholder" />
											</span>
											<span class="publications-author-filter-trigger-text" id="pub-author-trigger-label">
												All authors
											</span>
										</button>
										<div
											class="publications-author-filter-menu"
											id="pub-author-menu"
											role="listbox"
											aria-labelledby="pub-author-filter-heading"
											hidden
										>
											<button
												type="button"
												class="publications-author-filter-option"
												role="option"
												data-slug=""
												data-label="All authors"
												aria-selected="true"
											>
												<span class="publications-author-filter-option-thumb" aria-hidden="true">
													<span class="publications-author-filter-thumb-placeholder" />
												</span>
												<span class="publications-author-filter-option-main">All authors</span>
											</button>
										</div>
									</div>
								</div>
							) : null
						}
						<div class="publications-title-search-field">
							<label class="publications-year-filter-label" for="pub-title-search">Search</label>
							<input
								type="search"
								class="publications-title-search-input"
								id="pub-title-search"
								name="titleSearch"
								placeholder="Search title or venue…"
								spellcheck="false"
								autocomplete="off"
								enterkeyhint="search"
							/>
						</div>
					</div>
					<p
						class="publications-filter-stats"
						id="pub-filter-stats"
						role="status"
						aria-live="polite"
						aria-label="Venue-type counts for the filtered publication list"
					>
						<span class="publications-filter-stats-summary">
							Total <strong id="pub-stat-total" class="publications-filter-stats-num">0</strong>
						</span>
						<span class="publications-filter-stats-sep publications-filter-stats-sep--em" aria-hidden="true">—</span>
						<span class="publications-filter-stats-kind publications-filter-stats-kind--journal">
							Journal <strong id="pub-stat-journal" class="publications-filter-stats-num">0</strong>
						</span>
						<span class="publications-filter-stats-sep publications-filter-stats-sep--dot" aria-hidden="true">·</span>
						<span class="publications-filter-stats-kind publications-filter-stats-kind--conference">
							Conference <strong id="pub-stat-conference" class="publications-filter-stats-num">0</strong>
						</span>
						<span class="publications-filter-stats-sep publications-filter-stats-sep--dot" aria-hidden="true">·</span>
						<span class="publications-filter-stats-kind publications-filter-stats-kind--workshop-plus">
							Workshop+ <strong id="pub-stat-workshop-plus" class="publications-filter-stats-num">0</strong>
						</span>
						<span class="publications-filter-stats-sep publications-filter-stats-sep--dot" aria-hidden="true">·</span>
						<span class="publications-filter-stats-kind publications-filter-stats-kind--preprint">
							Preprint <strong id="pub-stat-preprint" class="publications-filter-stats-num">0</strong>
						</span>
					</p>
					<p id="pubs-year-filter-empty" class="publications-year-filter-empty muted" hidden>
						No publications match these filters.
					</p>
					<ul class="publications-cards" role="list" id="publications-cards-list">
						{papers.map((p) => (
							<li
								class="publications-cards-item"
								data-year={String(p.data.year)}
								data-listing-kind={publicationListingKind(p.data)}
								data-search-haystack={publicationSearchHaystack(p.data)}
								data-member-slugs={memberSlugsOnPublicationPaper(p, authorSlugLookup).join(' ')}
							>
								<PublicationListItem entry={p} authorSlugLookup={authorSlugLookup} />
							</li>
						))}
					</ul>
					{
						memberAuthorFilterOptions.length > 0 ? (
							<script
								type="application/json"
								id="pub-author-catalog"
								set:html={JSON.stringify(authorCatalogForClient)}
							/>
						) : null
					}
				</div>
			)
		}
	</div>
	<script is:inline>
		(function () {
			const wrap = document.querySelector('.publications-list-wrap');
			if (!wrap) return;
			const pickerMin = Number(wrap.dataset.pickerMin);
			const pickerMax = Number(wrap.dataset.pickerMax);
			const defaultStart = Number(wrap.dataset.defaultStart);
			const defaultEnd = Number(wrap.dataset.defaultEnd);
			const startSelect = document.getElementById('pub-year-start');
			const endSelect = document.getElementById('pub-year-end');
			if (!startSelect || !endSelect) return;
			const emptyEl = document.getElementById('pubs-year-filter-empty');
			const items = wrap.querySelectorAll('.publications-cards-item[data-year]');
			const statTotal = document.getElementById('pub-stat-total');
			const statJournal = document.getElementById('pub-stat-journal');
			const statConference = document.getElementById('pub-stat-conference');
			const statWorkshopPlus = document.getElementById('pub-stat-workshop-plus');
			const statPreprint = document.getElementById('pub-stat-preprint');
			const titleSearchInput = document.getElementById('pub-title-search');
			const authorRoot = document.getElementById('pub-author-filter-root');
			const authorTrigger = document.getElementById('pub-author-trigger');
			const authorMenu = document.getElementById('pub-author-menu');
			const authorTriggerThumb = authorTrigger
				? authorTrigger.querySelector('.publications-author-filter-trigger-thumb')
				: null;
			const authorTriggerLabel = document.getElementById('pub-author-trigger-label');

			function clamp(n, a, b) {
				if (Number.isNaN(n)) return a;
				return Math.min(b, Math.max(a, n));
			}

			function readYearRangeFromLocation() {
				const params = new URLSearchParams(window.location.search);
				let lo = parseInt(params.get('yearStart') ?? '', 10);
				let hi = parseInt(params.get('yearEnd') ?? '', 10);
				if (Number.isNaN(lo)) lo = defaultStart;
				if (Number.isNaN(hi)) hi = defaultEnd;
				lo = clamp(lo, pickerMin, pickerMax);
				hi = clamp(hi, pickerMin, pickerMax);
				return { lo, hi: Math.max(lo, hi) };
			}

			function syncYearRangeToLocation(lo, hi) {
				const params = new URLSearchParams(window.location.search);
				if (lo === defaultStart) params.delete('yearStart');
				else params.set('yearStart', String(lo));
				if (hi === defaultEnd) params.delete('yearEnd');
				else params.set('yearEnd', String(hi));
				const qs = params.toString();
				const next = qs ? window.location.pathname + '?' + qs : window.location.pathname;
				const current = window.location.pathname + window.location.search;
				if (next !== current) {
					history.replaceState(null, '', next);
				}
			}

			function rebuildEndOptions(startVal, preferredEnd) {
				const lo = clamp(startVal, pickerMin, pickerMax);
				let endVal = preferredEnd;
				if (endVal == null || Number.isNaN(endVal)) {
					endVal = parseInt(endSelect.value, 10);
				}
				endVal = clamp(Number.isNaN(endVal) ? lo : endVal, lo, pickerMax);
				endSelect.innerHTML = '';
				for (let y = lo; y <= pickerMax; y++) {
					const opt = document.createElement('option');
					opt.value = String(y);
					opt.textContent = String(y);
					endSelect.appendChild(opt);
				}
				endSelect.value = String(endVal);
			}

			function getSelectedAuthorSlug() {
				return wrap.getAttribute('data-selected-author') || '';
			}

			function getTitleQueryNormalized() {
				if (!titleSearchInput) return '';
				return String(titleSearchInput.value || '')
					.trim()
					.toLowerCase();
			}

			function setAuthorMenuOpen(open) {
				if (!authorMenu || !authorTrigger) return;
				authorMenu.hidden = !open;
				authorTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
			}

			function syncAuthorTrigger() {
				if (!authorTrigger || !authorTriggerThumb || !authorTriggerLabel || !authorMenu) return;
				const slug = getSelectedAuthorSlug();
				let selectedBtn = null;
				for (const btn of authorMenu.querySelectorAll('.publications-author-filter-option')) {
					const s = btn.getAttribute('data-slug') ?? '';
					if (s === slug) {
						selectedBtn = btn;
						break;
					}
				}
				if (!selectedBtn) {
					selectedBtn = authorMenu.querySelector('.publications-author-filter-option[data-slug=""]');
				}
				for (const btn of authorMenu.querySelectorAll('.publications-author-filter-option')) {
					btn.setAttribute('aria-selected', btn === selectedBtn ? 'true' : 'false');
				}
				const label = selectedBtn ? selectedBtn.getAttribute('data-label') || 'All authors' : 'All authors';
				const count = selectedBtn ? selectedBtn.getAttribute('data-count') : null;
				authorTriggerLabel.textContent =
					count && count !== '' ? `${label} (${count})` : label;
				const optImg = selectedBtn ? selectedBtn.querySelector('.publications-author-filter-option-img') : null;
				const src = optImg ? optImg.getAttribute('src') : null;
				authorTriggerThumb.innerHTML = '';
				if (src) {
					const im = document.createElement('img');
					im.className = 'publications-author-filter-option-img';
					im.setAttribute('alt', '');
					im.setAttribute('width', '28');
					im.setAttribute('height', '28');
					im.src = src;
					authorTriggerThumb.appendChild(im);
				} else {
					const ph = document.createElement('span');
					ph.className = 'publications-author-filter-thumb-placeholder';
					authorTriggerThumb.appendChild(ph);
				}
			}

			function setSelectedAuthor(slug) {
				wrap.setAttribute('data-selected-author', slug || '');
				apply();
			}

			let authorCatalogCache = null;
			function getAuthorCatalog() {
				if (authorCatalogCache !== null) return authorCatalogCache;
				const el = document.getElementById('pub-author-catalog');
				if (!el || !el.textContent) {
					authorCatalogCache = [];
					return authorCatalogCache;
				}
				try {
					authorCatalogCache = JSON.parse(el.textContent.trim());
				} catch (_) {
					authorCatalogCache = [];
				}
				return authorCatalogCache;
			}

			function lastNameSortKeyClient(name) {
				const parts = String(name)
					.trim()
					.split(/\s+/)
					.filter(Boolean);
				return (parts[parts.length - 1] || '').toLowerCase();
			}

			function rebuildAuthorMenuForYearRange(lo, hi) {
				if (!authorMenu) return;
				const catalog = getAuthorCatalog();
				if (!catalog.length) return;
				const titleQ = getTitleQueryNormalized();
				const countBySlug = {};
				items.forEach((li) => {
					const y = parseInt(li.getAttribute('data-year'), 10);
					if (Number.isNaN(y) || y < lo || y > hi) return;
					const hay = li.getAttribute('data-search-haystack') || '';
					if (titleQ && hay.indexOf(titleQ) === -1) return;
					const raw = li.getAttribute('data-member-slugs') || '';
					raw.split(/\s+/).filter(Boolean).forEach(function (slug) {
						countBySlug[slug] = (countBySlug[slug] || 0) + 1;
					});
				});
				const cur = getSelectedAuthorSlug();
				if (cur && !countBySlug[cur]) {
					wrap.setAttribute('data-selected-author', '');
				}
				while (authorMenu.firstChild) {
					authorMenu.removeChild(authorMenu.firstChild);
				}
				const allBtn = document.createElement('button');
				allBtn.type = 'button';
				allBtn.className = 'publications-author-filter-option';
				allBtn.setAttribute('role', 'option');
				allBtn.setAttribute('data-slug', '');
				allBtn.setAttribute('data-label', 'All authors');
				allBtn.setAttribute('aria-selected', 'false');
				const allThumb = document.createElement('span');
				allThumb.className = 'publications-author-filter-option-thumb';
				allThumb.setAttribute('aria-hidden', 'true');
				const allPh = document.createElement('span');
				allPh.className = 'publications-author-filter-thumb-placeholder';
				allThumb.appendChild(allPh);
				const allMain = document.createElement('span');
				allMain.className = 'publications-author-filter-option-main';
				allMain.textContent = 'All authors';
				allBtn.appendChild(allThumb);
				allBtn.appendChild(allMain);
				authorMenu.appendChild(allBtn);

				const authors = catalog
					.filter(function (a) {
						return countBySlug[a.slug] > 0;
					})
					.map(function (a) {
						return { slug: a.slug, name: a.name, photoHref: a.photoHref, count: countBySlug[a.slug] };
					})
					.sort(function (x, y) {
						const lx = lastNameSortKeyClient(x.name);
						const ly = lastNameSortKeyClient(y.name);
						const c = lx.localeCompare(ly);
						return c !== 0 ? c : x.name.localeCompare(y.name);
					});

				authors.forEach(function (a) {
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'publications-author-filter-option';
					btn.setAttribute('role', 'option');
					btn.setAttribute('data-slug', a.slug);
					btn.setAttribute('data-label', a.name);
					btn.setAttribute('data-count', String(a.count));
					btn.setAttribute('aria-selected', 'false');
					const thumb = document.createElement('span');
					thumb.className = 'publications-author-filter-option-thumb';
					thumb.setAttribute('aria-hidden', 'true');
					if (a.photoHref) {
						const img = document.createElement('img');
						img.className = 'publications-author-filter-option-img';
						img.src = a.photoHref;
						img.setAttribute('alt', '');
						img.setAttribute('width', '28');
						img.setAttribute('height', '28');
						img.loading = 'lazy';
						thumb.appendChild(img);
					} else {
						const ph = document.createElement('span');
						ph.className = 'publications-author-filter-thumb-placeholder';
						thumb.appendChild(ph);
					}
					const main = document.createElement('span');
					main.className = 'publications-author-filter-option-main';
					main.appendChild(document.createTextNode(a.name + ' '));
					const cspan = document.createElement('span');
					cspan.className = 'publications-author-filter-option-count muted';
					cspan.textContent = '(' + a.count + ')';
					main.appendChild(cspan);
					btn.appendChild(thumb);
					btn.appendChild(main);
					authorMenu.appendChild(btn);
				});
			}

			function apply() {
				const lo = clamp(parseInt(startSelect.value, 10), pickerMin, pickerMax);
				const hi = clamp(parseInt(endSelect.value, 10), pickerMin, pickerMax);
				const endYear = Math.max(lo, hi);
				startSelect.value = String(lo);
				endSelect.value = String(endYear);
				rebuildAuthorMenuForYearRange(lo, endYear);
				const authorSlug = getSelectedAuthorSlug();
				const titleQ = getTitleQueryNormalized();
				let visible = 0;
				let nJournal = 0;
				let nConference = 0;
				let nWorkshopPlus = 0;
				let nPreprint = 0;
				items.forEach((li) => {
					const y = parseInt(li.getAttribute('data-year'), 10);
					const yearOk = !Number.isNaN(y) && y >= lo && y <= endYear;
					const hay = li.getAttribute('data-search-haystack') || '';
					const titleOk = !titleQ || hay.indexOf(titleQ) !== -1;
					const raw = li.getAttribute('data-member-slugs') || '';
					const slugs = raw.split(/\s+/).filter(Boolean);
					const authorOk = !authorSlug || slugs.indexOf(authorSlug) !== -1;
					const show = yearOk && titleOk && authorOk;
					li.toggleAttribute('hidden', !show);
					if (!show) return;
					visible += 1;
					const kind = li.getAttribute('data-listing-kind') || 'other';
					if (kind === 'journal') nJournal += 1;
					else if (kind === 'conference') nConference += 1;
					else if (kind === 'preprint') nPreprint += 1;
					else nWorkshopPlus += 1;
				});
				if (emptyEl) emptyEl.hidden = visible > 0;
				if (statTotal) statTotal.textContent = String(visible);
				if (statJournal) statJournal.textContent = String(nJournal);
				if (statConference) statConference.textContent = String(nConference);
				if (statWorkshopPlus) statWorkshopPlus.textContent = String(nWorkshopPlus);
				if (statPreprint) statPreprint.textContent = String(nPreprint);
				if (authorMenu) syncAuthorTrigger();
				syncYearRangeToLocation(lo, endYear);
			}

			function onStartChange() {
				const lo = clamp(parseInt(startSelect.value, 10), pickerMin, pickerMax);
				const hi = clamp(parseInt(endSelect.value, 10), pickerMin, pickerMax);
				rebuildEndOptions(lo, hi);
				apply();
			}

			function syncFiltersFromLocation() {
				const range = readYearRangeFromLocation();
				startSelect.value = String(range.lo);
				rebuildEndOptions(range.lo, range.hi);
				apply();
			}

			startSelect.addEventListener('change', onStartChange);
			endSelect.addEventListener('change', apply);
			/* `input` fires on `<select>` value change in current browsers; `change` alone can miss edge cases. */
			startSelect.addEventListener('input', onStartChange);
			endSelect.addEventListener('input', apply);
			if (titleSearchInput) {
				titleSearchInput.addEventListener('input', apply);
				titleSearchInput.addEventListener('search', apply);
			}

			if (authorRoot && authorTrigger && authorMenu) {
				authorTrigger.addEventListener('click', function (e) {
					e.stopPropagation();
					const open = authorMenu.hidden;
					setAuthorMenuOpen(open);
				});
				authorMenu.addEventListener('click', function (e) {
					const btn = e.target.closest('.publications-author-filter-option');
					if (!btn || !authorMenu.contains(btn)) return;
					const slug = btn.getAttribute('data-slug') ?? '';
					setSelectedAuthor(slug);
					setAuthorMenuOpen(false);
				});
				document.addEventListener('click', function () {
					setAuthorMenuOpen(false);
				});
				authorRoot.addEventListener('click', function (e) {
					e.stopPropagation();
				});
				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape' && authorMenu && !authorMenu.hidden) {
						setAuthorMenuOpen(false);
					}
				});
			}

			syncFiltersFromLocation();
			window.addEventListener('pageshow', syncFiltersFromLocation);
		})();
	</script>
</BaseLayout>
