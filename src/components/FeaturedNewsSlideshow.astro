---
import type { CollectionEntry } from 'astro:content';
import { formatNewsDate } from '../lib/dates';
import { teaserFromNewsBody } from '../lib/newsTeaser';
import { siteHref } from '../lib/siteHref';

interface Props {
	entries: CollectionEntry<'highlights'>[];
}

const { entries } = Astro.props;

/** Stable ID (single slideshow on the home page). */
const uid = 'home-featured-slideshow';
---

{
	entries.length > 0 ? (
		<section
			class="home-featured-slideshow"
			aria-roledescription="carousel"
			aria-label="Home news carousel"
		>
			<div class="home-featured-slideshow-inner container-narrow">
				<div
					class="featured-slideshow-root"
					data-featured-slideshow={uid}
					data-slide-count={String(entries.length)}
				>
					<div class="featured-slideshow-viewport">
						{entries.map((entry, slideIndex) => {
							const href = siteHref(`/highlights/${entry.id}/`);
							const imgSrc = entry.data.coverImage
								? siteHref(entry.data.coverImage)
								: null;
							const teaser =
								teaserFromNewsBody(entry.body, 200) || 'Open for details.';

							return (
								<article
									class:list={[
										'featured-slide',
										{ 'is-active': slideIndex === 0 },
									]}
									data-slide
									id={`${uid}-slide-${slideIndex}`}
									aria-roledescription="slide"
									aria-label={`Slide ${slideIndex + 1} of ${entries.length}`}
								>
									<a class="featured-slide-link" href={href} tabindex={slideIndex === 0 ? 0 : -1}>
										<div class="featured-slide-media">
											{imgSrc ? (
												<img
													src={imgSrc}
													alt=""
													width="1600"
													height="900"
													loading={slideIndex === 0 ? 'eager' : 'lazy'}
													decoding="async"
													class="featured-slide-img"
												/>
											) : (
												<div class="featured-slide-placeholder" aria-hidden="true" />
											)}
										</div>
										<div class="featured-slide-scrim" aria-hidden="true" />
										<div class="featured-slide-caption">
											<p class="featured-slide-meta">{formatNewsDate(entry.data.date)}</p>
											<h3 class="featured-slide-title">{entry.data.title}</h3>
											<p class="featured-slide-desc">{teaser}</p>
										</div>
									</a>
								</article>
							);
						})}
					</div>

					{entries.length > 1 ? (
						<div class="featured-slideshow-controls">
							<div class="featured-slideshow-arrows">
								<button
									type="button"
									class="featured-slideshow-btn featured-slideshow-btn--prev"
									data-prev
									aria-label="Previous slide"
								>
									<span aria-hidden="true">‹</span>
								</button>
								<button
									type="button"
									class="featured-slideshow-btn featured-slideshow-btn--next"
									data-next
									aria-label="Next slide"
								>
									<span aria-hidden="true">›</span>
								</button>
							</div>
							<div class="featured-slideshow-dots" role="tablist" aria-label="Choose slide">
								{entries.map((_, i) => (
									<button
										type="button"
										class:list={['featured-slideshow-dot', { 'is-active': i === 0 }]}
										data-dot
										data-index={String(i)}
										role="tab"
										aria-selected={i === 0 ? 'true' : 'false'}
										aria-controls={`${uid}-slide-${i}`}
										aria-label={`Show slide ${i + 1}`}
									/>
								))}
							</div>
						</div>
					) : null}
				</div>
			</div>
		</section>
	) : null
}

<style>
	.home-featured-slideshow {
		background: var(--banner);
		color: var(--on-banner);
		padding-block: 1rem 1.35rem;
		border-bottom: 1px solid var(--on-banner-border);
	}

	.home-featured-slideshow-inner {
		padding-inline: 1.25rem;
	}

	.featured-slideshow-root {
		position: relative;
	}

	.featured-slideshow-viewport {
		position: relative;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--on-banner-border);
		box-shadow: 0 18px 48px rgb(0 0 0 / 0.35);
		width: 100%;
		margin-inline: auto;
		aspect-ratio: 16 / 9;
		background: rgb(0 0 0 / 0.35);
	}

	.featured-slide {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.45s ease,
			visibility 0.45s ease;
	}

	.featured-slide.is-active {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.home-featured-slideshow .featured-slide {
			transition: none;
		}
	}

	.featured-slide-link {
		display: block;
		height: 100%;
		color: inherit;
		text-decoration: none;
		outline-offset: -2px;
	}

	.featured-slide-link:hover .featured-slide-title {
		color: #fff;
		text-decoration-color: rgb(251 191 36 / 0.65);
	}

	.featured-slide-link:focus-visible {
		outline: 2px solid var(--highlight);
	}

	.featured-slide-media {
		position: absolute;
		inset: 0;
		background: linear-gradient(145deg, #1e293b 0%, #0f172a 42%, #020617 100%);
	}

	.featured-slide-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		max-width: none;
		display: block;
	}

	.featured-slide-placeholder {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 30% 20%, rgb(71 85 105 / 0.45), rgb(15 23 42 / 0.95)),
			linear-gradient(158deg, #111827 0%, #0f172a 100%);
	}

	.featured-slide-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgb(2 6 23 / 0.92) 0%,
			rgb(2 6 23 / 0.55) 38%,
			transparent 68%
		);
		pointer-events: none;
	}

	.featured-slide-caption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		box-sizing: border-box;
		padding: 2.75rem clamp(1rem, 3vw, 2rem) 1.1rem;
		z-index: 2;
		pointer-events: none;
	}

	.featured-slide-link :where(.featured-slide-meta, .featured-slide-title, .featured-slide-desc) {
		pointer-events: none;
	}

	.featured-slide-meta {
		margin: 0 0 0.35rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--banner-meta);
	}

	.featured-slide-title {
		margin: 0 0 0.4rem;
		font-size: clamp(1.12rem, 2.8vw, 1.65rem);
		font-weight: 800;
		line-height: 1.22;
		color: var(--on-banner);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.15em;
		transition: text-decoration-color 0.15s ease, color 0.15s ease;
		display: -webkit-box;
		line-clamp: 2;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.featured-slide-desc {
		margin: 0;
		font-size: clamp(0.855rem, 1.85vw, 0.935rem);
		line-height: 1.48;
		color: rgb(241 245 249 / 0.95);
		max-width: none;
		width: 100%;
		text-wrap: pretty;
		display: -webkit-box;
		line-clamp: 3;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.featured-slideshow-controls {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.5rem 1rem;
		margin-top: 0.75rem;
		padding-inline: 0.15rem;
	}

	.featured-slideshow-arrows {
		grid-column: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
	}

	.featured-slideshow-btn {
		width: 2.35rem;
		height: 2.35rem;
		border-radius: 999px;
		border: 1px solid var(--on-banner-border);
		background: var(--on-banner-card);
		color: var(--on-banner);
		font-size: 1.35rem;
		line-height: 1;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.featured-slideshow-btn:hover {
		background: var(--on-banner-card-hover);
	}

	.featured-slideshow-btn:focus-visible {
		outline: 2px solid var(--highlight);
		outline-offset: 2px;
	}

	.featured-slideshow-dots {
		grid-column: 3;
		justify-self: end;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.4rem;
		max-width: 100%;
	}

	.featured-slideshow-dot {
		width: 0.52rem;
		height: 0.52rem;
		padding: 0;
		border-radius: 999px;
		border: 1px solid var(--on-banner-border);
		background: rgb(255 255 255 / 0.28);
		cursor: pointer;
		transition:
			transform 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.featured-slideshow-dot.is-active {
		background: var(--highlight);
		border-color: rgb(147 197 253 / 0.9);
		transform: scale(1.12);
	}

	.featured-slideshow-dot:focus-visible {
		outline: 2px solid var(--highlight);
		outline-offset: 3px;
	}
</style>

<script is:inline define:vars={{ uid }}>
	(() => {
		const root = document.querySelector(`[data-featured-slideshow="${uid}"]`);
		if (!root) return;

		const slides = [...root.querySelectorAll('[data-slide]')];
		const dots = [...root.querySelectorAll('[data-dot]')];
		const prevBtn = root.querySelector('[data-prev]');
		const nextBtn = root.querySelector('[data-next]');
		if (slides.length <= 1) return;

		let index = 0;
		let timer = null;
		/** Autoplay interval — was 7s; longer gives time to read the caption overlay. */
		const intervalMs = 14_000;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function setTabindex(slideEl, active) {
			const link = slideEl.querySelector('a');
			if (link) link.tabIndex = active ? 0 : -1;
		}

		function go(nextIndex) {
			const n = (nextIndex + slides.length) % slides.length;
			index = n;
			slides.forEach((el, i) => {
				const active = i === n;
				el.classList.toggle('is-active', active);
				el.setAttribute('aria-hidden', active ? 'false' : 'true');
				setTabindex(el, active);
			});
			dots.forEach((d, i) => {
				const active = i === n;
				d.classList.toggle('is-active', active);
				d.setAttribute('aria-selected', active ? 'true' : 'false');
			});
		}

		function armTimer() {
			if (reduceMotion) return;
			clearInterval(timer);
			timer = window.setInterval(() => go(index + 1), intervalMs);
		}

		function disarmTimer() {
			clearInterval(timer);
			timer = null;
		}

		slides.forEach((el, i) => {
			el.setAttribute('aria-hidden', i === 0 ? 'false' : 'true');
			setTabindex(el, i === 0);
		});

		prevBtn?.addEventListener('click', () => {
			go(index - 1);
			armTimer();
		});
		nextBtn?.addEventListener('click', () => {
			go(index + 1);
			armTimer();
		});

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const raw = dot.getAttribute('data-index');
				const i = raw == null ? 0 : Number.parseInt(raw, 10);
				if (!Number.isNaN(i)) {
					go(i);
					armTimer();
				}
			});
		});

		root.addEventListener('mouseenter', disarmTimer);
		root.addEventListener('mouseleave', armTimer);
		root.addEventListener('focusin', disarmTimer);
		root.addEventListener('focusout', (e) => {
			if (root.contains(e.relatedTarget)) return;
			armTimer();
		});

		armTimer();
	})();
</script>
