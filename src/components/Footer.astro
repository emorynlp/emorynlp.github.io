---

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container-narrow footer-inner">
		<div class="footer-col">
			<strong class="footer-name">Emory NLP</strong>
			<p class="footer-address muted">
				400 Dowman Drive, Atlanta, GA, USA<br />
				Math and Science Center, Suite W401
			</p>
		</div>
		<div class="footer-col">
			<p class="eyebrow">Connect</p>
			<ul class="social-links">
				<li>
					<a href="https://www.linkedin.com/company/emorynlp">LinkedIn</a>
				</li>
				<li>
					<a href="https://www.youtube.com/c/EmoryNLPStudio">YouTube</a>
				</li>
				<li>
					<a href="https://github.com/emorynlp">GitHub</a>
				</li>
			</ul>
		</div>
	</div>
	<p class="copyright container-narrow muted">
		© {year} Emory NLP. Hosted on{' '}
		<a href="https://pages.github.com/">GitHub Pages</a>.
	</p>
</footer>

<style>
	.site-footer {
		margin-top: 3rem;
		padding-block: 2rem 1.25rem;
		border-top: 1px solid var(--border);
		background: var(--surface);
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 2.5rem;
		justify-content: space-between;
		align-items: flex-start;
	}
	.footer-name {
		display: block;
		margin-bottom: 0.5rem;
		color: var(--ink);
	}
	.footer-address {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.55;
	}
	.social-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
	}
	.social-links a {
		font-weight: 600;
		font-size: 0.9rem;
	}
	.copyright {
		margin: 1.75rem auto 0;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		font-size: 0.8125rem;
		text-align: center;
	}
</style>
