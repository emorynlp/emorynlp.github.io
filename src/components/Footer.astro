---

const year = new Date().getFullYear();

const socialLinks = [
	{
		network: 'linkedin',
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/company/emorynlp',
	},
	{
		network: 'youtube',
		label: 'YouTube',
		href: 'https://www.youtube.com/c/EmoryNLPStudio',
	},
	{
		network: 'github',
		label: 'GitHub',
		href: 'https://github.com/emorynlp',
	},
];
---

<footer class="site-footer">
	<div class="container-narrow footer-inner">
		<div class="footer-brand-row">
			<strong class="footer-name">Emory NLP</strong>
			<ul class="footer-social" role="list">
				{
					socialLinks.map((link) => (
						<li class={`footer-social-item footer-social-item--${link.network}`}>
							<a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
								<span class="footer-social-icon" aria-hidden="true">
									{
										link.network === 'linkedin' ? (
											<svg viewBox="0 0 24 24" width="24" height="24">
												<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
											</svg>
										) : link.network === 'youtube' ? (
											<svg viewBox="0 0 24 24" width="24" height="24">
												<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
											</svg>
										) : (
											<svg viewBox="0 0 24 24" width="24" height="24">
												<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
											</svg>
										)
									}
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<p class="footer-address muted">
			400 Dowman Drive, Atlanta, GA, USA<br />
			Math and Science Center, Suite W401
		</p>
	</div>
	<p class="copyright container-narrow muted">
		© {year} Emory NLP. All rights reserved.
	</p>
</footer>

<style>
	.site-footer {
		margin-top: 0;
		padding-block: 2rem 1.25rem;
		border-top: 1px solid var(--on-banner-border);
		background: var(--header-bg);
		background-attachment: fixed;
		color: var(--on-banner);
		box-shadow: 0 -4px 24px rgb(15 23 42 / 0.35);
	}

	.site-footer .muted {
		color: var(--banner-meta);
	}

	.footer-inner {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer-brand-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem 0.85rem;
	}

	.footer-name {
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--brand-warm);
	}

	.footer-address {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.55;
	}

	.footer-social {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.footer-social a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		color: var(--banner-meta);
		text-decoration: none;
		border-radius: 4px;
		transition: color 0.15s ease;
	}

	.footer-social a:hover,
	.footer-social a:active {
		color: var(--brand-warm);
	}

	.footer-social a:focus-visible {
		outline: 2px solid var(--brand-warm-dark);
		outline-offset: 3px;
	}

	.footer-social-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.125rem;
		height: 1.125rem;
		flex-shrink: 0;
	}

	.footer-social-icon svg {
		display: block;
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	.footer-social-item--youtube .footer-social-icon svg {
		transform: scale(1.14);
		transform-origin: center;
	}

	.footer-social-item--github .footer-social-icon svg {
		transform: scale(1.06);
		transform-origin: center;
	}

	.copyright {
		margin: 1.75rem auto 0;
		padding-top: 1rem;
		border-top: 1px solid var(--on-banner-border);
		font-size: 0.8125rem;
		text-align: center;
	}

	.copyright a {
		color: var(--banner-meta);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.copyright a:hover,
	.copyright a:active {
		color: var(--brand-warm);
	}

	.copyright a:focus-visible {
		outline: 2px solid var(--brand-warm-dark);
		outline-offset: 3px;
		border-radius: 4px;
	}
</style>
