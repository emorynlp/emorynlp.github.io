---
import { siteHref } from '../lib/siteHref';

function navActive(linkHref: string, pathname: string): boolean {
	const pn = pathname.replace(/\/+$/, '') || '/';
	const href = linkHref.replace(/\/+$/, '') || '/';
	return pn === href || pn.startsWith(`${href}/`);
}

const linkDefs = [
	{ path: '/', label: 'Home' },
	{ path: '/people/', label: 'People' },
	{ path: '/papers/', label: 'Papers' },
	{ path: '/seminars/', label: 'Seminars' },
	{ path: '/news/', label: 'News' },
	{ path: '/dispatch/', label: 'Dispatch' },
];

const links = linkDefs.map((l) => ({ ...l, href: siteHref(l.path) }));
---

<header class="site-header">
	<div class="site-header-inner container-narrow">
		<a class="brand" href={siteHref('/')}>
			<img
				class="brand-logo"
				src={siteHref('/emorynlp-logo.png')}
				alt=""
				width="44"
				height="44"
				loading="eager"
				decoding="async"
				aria-hidden="true"
			/>
			<span class="brand-text">
				<span class="brand-title">Emory NLP</span>
				<span class="brand-tag">Atlanta GA, USA</span>
			</span>
		</a>
		<nav aria-label="Primary">
			<ul class="nav-list">
				{
					links.map((l) => (
						<li>
							<a
								class:list={[
									'site-nav-link',
									{
										'site-nav-link--current': navActive(l.href, Astro.url.pathname),
									},
								]}
								href={l.href}
							>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--header-bg);
		background-attachment: fixed;
		border-bottom: 1px solid var(--on-banner-border);
		box-shadow: 0 4px 24px rgb(15 23 42 / 0.35);
	}
	.site-header-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		min-height: var(--nav-h);
		padding-block: 0.65rem;
	}
	.brand {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		color: var(--on-banner);
	}
	.brand-logo {
		height: 2.75rem;
		width: auto;
		max-width: 8rem;
		object-fit: contain;
		flex-shrink: 0;
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 0;
		min-width: 0;
	}
	.brand-title {
		font-weight: 800;
		font-size: 1.14rem;
		letter-spacing: -0.02em;
		color: var(--brand-warm);
	}
	.brand-tag {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--brand-warm-dark);
	}
	.nav-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.85rem;
		list-style: none;
		margin: 0;
		padding: 0;
		align-items: center;
	}
	.site-header .site-nav-link:link,
	.site-header .site-nav-link:visited,
	.site-header .site-nav-link:any-link {
		font-size: 0.885rem;
		font-weight: 600;
		color: var(--banner-meta);
		text-decoration: none !important;
		text-decoration-line: none !important;
		text-underline-offset: 0 !important;
		padding: 0.35rem 0;
		border: 0 !important;
		box-shadow: none !important;
		-webkit-tap-highlight-color: transparent;
		transition: color 0.15s ease;
	}

	.site-header .site-nav-link:hover {
		color: var(--brand-warm);
		text-decoration: none !important;
	}

	.site-header .site-nav-link:active {
		color: var(--brand-warm);
		text-decoration: none !important;
		border: 0 !important;
	}

	.site-header .site-nav-link--current:link,
	.site-header .site-nav-link--current:visited,
	.site-header .site-nav-link--current:any-link {
		color: var(--brand-warm);
		text-decoration: none !important;
	}

	.site-header .site-nav-link:focus:not(:focus-visible) {
		outline: none;
	}

	.site-header .site-nav-link:focus-visible {
		outline: 2px solid var(--brand-warm-dark);
		outline-offset: 4px;
		border-radius: 4px;
	}
</style>
